<!--
    This XML file declares which signature|privileged permissions should be granted to privileged
    applications that come with the platform.
-->
<permissions>
    <privapp-permissions package="com.samsung.android.applock">

        <!-- UI & System Control -->
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.EXPAND_STATUS_BAR"/>

        <!-- Process & Task Management -->
        <permission name="android.permission.SET_PROCESS_LIMIT"/>
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.FORCE_STOP_PACKAGES"/>
        <permission name="android.permission.KILL_BACKGROUND_PROCESSES"/>
        <permission name="android.permission.MANAGE_ACTIVITY_STACKS"/>

        <!-- User & Profile Management -->
        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <permission name="android.permission.CREATE_USERS"/>

        <!-- Network -->
        <permission name="android.permission.ACCESS_NETWORK_STATE"/>
        <permission name="android.permission.ACCESS_WIFI_STATE"/>

        <!-- Biometrics & Security -->
        <permission name="android.permission.USE_FINGERPRINT"/>
        <permission name="android.permission.USE_BIOMETRIC"/>
        <permission name="android.permission.MANAGE_BIOMETRIC"/>

        <!-- Phone State -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.READ_PHONE_STATE"/>

        <!-- App Lock Specific -->
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.OBSERVE_APP_USAGE"/>
        <permission name="android.permission.GET_APP_OPS_STATS"/>

    </privapp-permissions>
</permissions>
